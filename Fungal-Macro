                If Cq = "Detected" Then
                    g1MLarr(g1MLcount) = MLtoNUM(EstCopyNum.Value)      'convert microbial load to a number and store in array
                    minCqArr(g1MLcount) = FinalCrtx2.Value     'store cq of detected target - will grab the lowest number later
                    g1MLcount = g1MLcount + 1
