Attribute VB_Name = "D_Microbial_Loads"
Public Function getMicrobialLoad(TargetName As String, minCq As Double) As String

Dim Low As String, Moderate As String, High As String

    Low = "Low"   '1,000 - 10,000 copies/uL
    Moderate = "Moderate"    '10,000 - 100,000 copies/uL
    High = "High" '> 100,000 copies/uL
    
            If (TargetName = "T. soudanense" Or TargetName = "T. rubrum" Or TargetName = "T. tonsurans" Or TargetName = "T. interdigitale" Or TargetName = "T. violaceum") Then
                If minCq > 24.509 Then
                    getMicrobialLoad = Low
                ElseIf (minCq <= 24.509 And minCq > 21.496) Then
                    getMicrobialLoad = Moderate
                ElseIf minCq <= 21.469 Then
                    getMicrobialLoad = High
                End If
                
                'microsporum spp
            ElseIf (TargetName = "M. canis" Or TargetName = "M. gypseum" Or TargetName = "M. nanum" Or TargetName = "M. audouinii") Then
                If minCq > 25.512 Then
                    getMicrobialLoad = Low
                ElseIf (minCq <= 25.512 And minCq > 22.177) Then
                    getMicrobialLoad = Moderate
                ElseIf minCq <= 22.177 Then
                    getMicrobialLoad = High
                End If
                
                'floccosum
            ElseIf TargetName = "E. floccosum" Then
                If minCq > 24.411 Then
                    getMicrobialLoad = Low
                ElseIf (minCq <= 24.411 And minCq > 21.496) Then
                    getMicrobialLoad = Moderate
                ElseIf minCq <= 21.496 Then
                    getMicrobialLoad = High
                End If
            End If

                'Non-Dermatophyte mold
            If (TargetName = "A. niger" Or TargetName = "A. terreus" Or TargetName = "A. fumigatus" Or TargetName = "A. versicolor") Then
                If minCq > 24.64 Then
                    getMicrobialLoad = Low
                ElseIf (minCq <= 24.64 And minCq > 21.48) Then
                    getMicrobialLoad = Moderate
                ElseIf minCq <= 21.48 Then
                    getMicrobialLoad = High
                End If
                
            ElseIf (TargetName = "A. strictum" And minCq > 24.324) Or (TargetName = "Alternaria spp." And minCq > 25.268) _
                    Or (TargetName = "F. solani" And minCq > 23.069) Or (TargetName = "G. candidum" And minCq > 25.281) _
                    Or (TargetName = "N. mangiferae" And minCq > 24.615) Or (TargetName = "S. brevicaulis" And minCq > 23.322) Then
                    
                    getMicrobialLoad = Low
                    
            ElseIf (TargetName = "A. strictum" And minCq <= 24.324 And minCq > 21.407) Or (TargetName = "Alternaria spp." And minCq <= 25.268 And minCq > 22.246) _
                    Or (TargetName = "F. solani" And minCq <= 23.069 And minCq > 19.952) Or (TargetName = "G. candidum" And minCq <= 25.281 And minCq > 22.255) _
                    Or (TargetName = "N. mangiferae" And minCq <= 24.615 And minCq > 21.445) Or (TargetName = "S. brevicaulis" And minCq <= 23.322 And minCq > 20.328) Then
                    
                    getMicrobialLoad = Moderate
                        
            ElseIf (TargetName = "A. strictum" And minCq <= 21.407) Or (TargetName = "Alternaria spp." And minCq <= 22.246) _
                    Or (TargetName = "F. solani" And minCq <= 19.952) Or (TargetName = "G. candidum" And minCq <= 22.255) _
                    Or (TargetName = "N. mangiferae" And minCq <= 21.445) Or (TargetName = "S. brevicaulis" And minCq <= 20.328) Then
                    
                    getMicrobialLoad = High
            End If
            
                'Yeast
            If (TargetName = "T. mucoides" Or TargetName = "T. beigelii") Then
                If minCq > 24.224 Then
                    getMicrobialLoad = Low
                ElseIf (minCq <= 24.224 And minCq > 21.327) Then
                    getMicrobialLoad = Moderate
                ElseIf minCq <= 21.327 Then
                    getMicrobialLoad = High
                End If
                
            ElseIf (TargetName = "C. albicans" Or TargetName = "C. parapsilosis") Then
                If minCq > 24.323 Then
                    getMicrobialLoad = Low
                ElseIf (minCq <= 24.323 And minCq > 21.376) Then
                    getMicrobialLoad = Moderate
                ElseIf minCq <= 21.376 Then
                    getMicrobialLoad = High
                End If
                
            ElseIf TargetName = "P. onychis" Then
                If minCq > 26.225 Then
                    getMicrobialLoad = Low
                ElseIf (minCq <= 26.225 And minCq > 23.249) Then
                    getMicrobialLoad = Moderate
                ElseIf minCq <= 23.249 Then
                    getMicrobialLoad = High
                End If
            End If
            
                'parasitic
            If TargetName = "S. scabiei" Then
                If minCq > 25.894 Then
                    getMicrobialLoad = Low
                ElseIf (minCq <= 25.894 And minCq > 22.737) Then
                    getMicrobialLoad = Moderate
                ElseIf minCq <= 22.737 Then
                    getMicrobialLoad = High
                End If
            End If
End Function

