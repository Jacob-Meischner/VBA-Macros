Attribute VB_Name = "H_Fungal_Misc"
Public Function RerunPatient(AccNum As String)

Dim RRtoPull As Worksheet, ImportPTInfo As Worksheet
Dim FindFullID As Range, RRtoPullLastRow As Long, RRtoPullDest As Range
Dim SplitArray As Variant, AccNumber As String, TargetName As String

SplitArray = Split(AccNum, ",", -1)
AccNumber = SplitArray(0)
TargetName = SplitArray(1)

Erase SplitArray

Set ImportPTInfo = ThisWorkbook.Sheets("Import Patient Information")

Set RRtoPull = ThisWorkbook.Sheets("Reruns To Pull")
    With RRtoPull
        RRtoPullLastRow = .Cells(.Rows.Count, "C").End(xlUp).Row
        Set RRtoPullDest = .Range("C" & RRtoPullLastRow).Offset(1, -2)
    End With

Set FindFullID = ImportPTInfo.Range("B12:B103").Find(AccNumber)

     If Not (FindFullID Is Nothing) Then
          If (FindFullID.Borders.Weight = xlThin) Then
               With RRtoPullDest
                    .Value = FindFullID.Value
               End With
               With RRtoPullDest.Offset(0, 1)
                    .Value = Trim(FindFullID.Offset(0, -1).Value)
               End With
               With RRtoPullDest.Offset(0, 2)
                    .Value = TargetName
               End With
               With RRtoPullDest.Offset(0, 3)
                    If (TargetName = "A. fumigatus" Or TargetName = "A. niger" Or TargetName = "A. terreus" Or TargetName = "A. versicolor") Then
                         .Value = "Aspergillus spp."
                    ElseIf (TargetName = "C. albicans" Or TargetName = "C. parapsilosis") Then
                         .Value = "Candida spp."
                    ElseIf (TargetName = "M. audouinii" Or TargetName = "M. canis" Or TargetName = "M. gypseum" Or TargetName = "M. nanum") Then
                         .Value = "Microsporum spp."
                    ElseIf (TargetName = "T. beigelii" Or TargetName = "T. mucoides") Then
                         .Value = "Trichosporon spp."
                    ElseIf (TargetName = "T. interdigitale" Or TargetName = "T. rubrum" Or TargetName = "T. soudanense" Or TargetName = "T. tonsurans" Or TargetName = "T. violaceum") Then
                         .Value = "Trichophyton spp."
                    End If
               End With
        Else
        End If
    Else
        MsgBox ("Could not find Accession Number: " & AccNumber & "on the 'Import Patient Information' worksheet.")
    End If
Set RRtoPullDest = RRtoPullDest.Offset(1, 0)

End Function
