                        .Value = genusName
                    End With
                    
                    If g1MLcount > 1 Then                                                  'check if count is > 1 - if so, then an individual target was detected for a group
                        ReDim Preserve g1MLarr(1 To g1MLcount - 1)
                        ReDim Preserve minCqArr(1 To g1MLcount - 1)
                        
                        With FinalCrtx2
                            .Value = Application.WorksheetFunction.Min(minCqArr)    'Minimum Cq
