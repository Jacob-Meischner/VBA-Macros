        Dim targName As Range
        Dim g1Arr, g2Arr, lastTargetArr
        Dim g1MLarr, g2MLarr, minCqArr, g2minCqArr
        Dim g1MLcount As Integer, g2MLcount As Integer
        Dim g1Match, g2Match, lastTargetMatch
        Dim genusName As String
        Dim minCq As Double, highestMLoad As Integer    '-----------------------changed highestMLoad from string to integer-------------------------------
        
