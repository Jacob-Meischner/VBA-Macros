                    End If
                        ReDim g1MLarr(1 To 5) As Variant
                        ReDim minCqArr(1 To 5) As Variant
                        g1MLcount = 1
                End If
            ElseIf Not IsError(g2Match) Then    'trichophyton group
                If Cq = "Detected" Then
                    g2MLarr(g2MLcount) = MLtoNUM(EstCopyNum.Value)
                    g2minCqArr(g2MLcount) = FinalCrtx2.Value
