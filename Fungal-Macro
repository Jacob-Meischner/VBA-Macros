Sub Create_Ligo_Exports_File()

Call OptimizeCode_Begin

Dim ws As Worksheet, LigoExportsWS As Worksheet, ImpPtInfo As Worksheet, SaveDuplicateFile As String, UTIFSO As Object, DupSourceLoc As String, DestinationLoc As String
Dim RangeValue As Range, LigoRanges As Range, i As Integer
Dim LigoExportsDest As Range, WSLastRow As Long, LigoExportsLastRow As Long
Dim AnalysisResultsPath As String, DuplicateFileLocation As String, FileNameConstant As String
Dim RackDate As Range, RackNumber As Range
Dim TrichphyDetected As Integer, GenericDetected As Integer
Dim HighECN As Integer, ModerateECN As Integer, LowECN As Integer
Dim HighCopy As String, ModerateCopy As String, LowCopy As String
Dim AccNum As Range, Target As Range, Result As Range, FinalCrt As Range, ESTcopy As Range
Dim PTC As String, PEC As String, NEC As String, NTC As String, TargetName As Range, ELastRow As Long, ChangingInfo As Range
Dim Cq As Range, FinalCrtx2 As Range, EstCopyNum As Range, TrichHighECN As Integer, TrichModECN As Integer, TrichLowECN As Integer
Dim ReviewYesNo

Dim CopyTopTreatment As String, CopySysTreatment As String, TrichphyTopTreat As String, TrichphySysTreat As String

AnalysisResultsPath = "X:\Analysis Results\"                         'Analysis Results file location -------------------------
DuplicateFileLocation = "X:\Resulting\Open Array\Nail (Fungal)\Duplicate LigoExports Files\" 'Duplicate file for us to refer to -------------------------

Set ImpPtInfo = ThisWorkbook.Sheets("Import Patient Information")
Set ws = ThisWorkbook.Sheets("OpenArray Raw Data")
Set LigoExportsWS = ThisWorkbook.Sheets("Ligo Exports")
'Set RackDate = ImpPtInfo.Range("B5")  come back to these - trim rack date so it's just the date and can be used in the naming of the ligo file
'Set RackNumber = ImpPtInfo.Range("B6")

If ws.AutoFilterMode = True Then
    With ws
        .AutoFilterMode = False
    End With
    Else
End If
    
PTC = "PTC"
PEC = "PEC"
NEC = "NEC"
NTC = "NTC"

HighCopy = "High"
ModerateCopy = "Moderate"
LowCopy = "Low"

        FileNameConstant = (Format(Now, "YYYYMMDD")) & "_Nail_RACKDATE_RACKNUMBER_Results"
        
        LigoExportsWS.Range("A1:Q3000").Clear
        
        WSLastRow = ws.Cells(Rows.Count, "D").End(xlUp).Row
        Set LigoExportsDest = LigoExportsWS.Cells(Rows.Count, "D").End(xlUp).Offset(1, 0)

        With LigoExportsWS
            .Range("A1").Value = "Well"
            .Range("B1").Value = "Fungal"
            .Range("D1").Value = "Sample"
            .Range("E1").Value = "Target"
            .Range("M1").Value = "Cq"
            .Range("N1").Value = ws.Range("N10").Value
            .Range("O1").Value = "Est Copy Number"
        End With
        
            For i = 11 To WSLastRow Step 3
            
                Set AccNum = ws.Range("D" & i)
                Set Target = ws.Range("E" & i)
                Set Result = ws.Range("M" & i)
                Set FinalCrt = ws.Range("N" & i)
                Set ESTcopy = ws.Range("O" & i)
                Set TopTreat = ws.Range("P" & i)
                Set SysTreat = ws.Range("Q" & i)
                Set LigoRanges = Application.Union(AccNum, Target, Result, FinalCrt, ESTcopy)       'Directly changing values of range variables will change the values on "OpenArray Raw Data" WS - I don't want that

                For Each RangeValue In LigoRanges   'If RangeValue is used as a locator, this value = what will be placed in the result file

                    If (LigoExportsDest.Column = 15 And LigoExportsDest.Offset(0, -1).Value = "500") Then     'Ligo repurposed the "Result Column" as Col O (15) - so bring all "Inconclusives" to this column so they show on the report
                        With LigoExportsDest                                'as long as the targets
                            .Value = "Inconclusive"
                        End With
                    ElseIf RangeValue = "" Then
                        GoTo NextRV
                    Else
                        With LigoExportsDest
                            .Value = RangeValue.Value
                        End With
                    End If
                    
NextRV:      If (LigoExportsDest.Column = 4 Or LigoExportsDest.Column = 13 Or LigoExportsDest.Column = 14) Then
                        Set LigoExportsDest = LigoExportsDest.Offset(0, 1)
                    ElseIf LigoExportsDest.Column = 5 Then
                        Set LigoExportsDest = LigoExportsDest.Offset(0, 8)
                    End If
                Next RangeValue
                        Set LigoExportsDest = LigoExportsDest.Offset(1, -11)
            Next i
            
            With LigoExportsWS
                ELastRow = .Cells(.Rows.Count, "E").End(xlUp).Row
